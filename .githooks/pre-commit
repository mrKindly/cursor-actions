#!/usr/bin/env bash
# Auto-update API/README documentation before commit.
# Runs update-docs.ts, then stages any files it modified.

echo ""
echo "Running documentation updater..."

cd "$(git rev-parse --show-toplevel)"

# IDEs and GUI Git often run hooks with a minimal PATH. Restore typical Node/npm locations.
PATH="${HOME}/.nodenv/shims:/opt/homebrew/bin:/usr/local/bin:${HOME}/.volta/bin:${HOME}/.local/bin:${PATH}"
export PATH

# nvm (https://github.com/nvm-sh/nvm)
NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
if [ -s "${NVM_DIR}/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "${NVM_DIR}/nvm.sh"
fi

# asdf
if [ -s "${HOME}/.asdf/asdf.sh" ]; then
  # shellcheck source=/dev/null
  . "${HOME}/.asdf/asdf.sh"
fi

# fnm (after PATH may include Homebrew’s fnm)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell sh 2>/dev/null)" || true
fi

# mise (https://mise.jdx.dev)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise hook-env -s sh 2>/dev/null)" || true
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm not found after extending PATH (Homebrew, nvm, asdf, fnm, mise, Volta)."
  echo "  Open a terminal where \`command -v npm\` works, run \`npm run prepare\`, then commit from the same machine;"
  echo "  or add Node’s bin directory to your GUI app’s environment (PATH)."
  exit 1
fi

npm run update-docs -- develop 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "pre-commit: documentation updater failed (exit $EXIT_CODE). Fix the error above, then commit again."
  exit $EXIT_CODE
fi

# Stage only documentation files that were modified by the updater
# (tracked files that are now different from the index)
MODIFIED=$(git ls-files --modified README.md src/app/api/ 2>/dev/null)
if [ -n "$MODIFIED" ]; then
  echo "$MODIFIED" | xargs git add
  echo "Staged updated documentation files:"
  echo "$MODIFIED" | sed 's/^/  /'
fi

exit 0
