#!/bin/sh
# Auto-update API/README documentation before commit.
# Runs update-docs.ts, then stages any files it modified.

echo ""
echo "Running documentation updater..."

cd "$(git rev-parse --show-toplevel)"

npm run update-docs -- develop 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "Warning: documentation updater exited with code $EXIT_CODE — proceeding with commit."
fi

# Stage only documentation files that were modified by the updater
# (tracked files that are now different from the index)
MODIFIED=$(git ls-files --modified README.md src/app/api/ 2>/dev/null)
if [ -n "$MODIFIED" ]; then
  echo "$MODIFIED" | xargs git add
  echo "Staged updated documentation files:"
  echo "$MODIFIED" | sed 's/^/  /'
fi

exit 0
