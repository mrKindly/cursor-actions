# Cursor — API key for scripts that call @cursor/sdk (Agent.prompt / cloud agents)
# Create a key in Cursor: Dashboard → Cloud Agents / API keys (see Cursor docs).
CURSOR_API_KEY=your_cursor_api_key
# Optional: model id passed to the SDK (scripts default to composer-2 if unset)
CURSOR_MODEL=composer-2

# GitHub Token (with repo scope)
GITHUB_TOKEN=your_github_token
GITHUB_REPO=owner/repo

# Jira Configuration
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=your_project_key

# Optional — loyalty / campaign discount booking API flag.
DISCOUNT_CODES_ENABLED=false